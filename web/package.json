{
  "name": "ch-fixedwidth-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Browser converter for Companies House fixed-width appointment snapshots",
  "scripts": {
    "postinstall": "bun run link-local",
    "link-local": "bun run scripts/link-local.ts",
    "copy-wasm": "bun run scripts/copy-wasm.ts",
    "icons": "bun run scripts/generate-icons.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite preview --port 3000",
    "smoke": "bun run copy-wasm && bun run scripts/smoke.ts"
  },
  "dependencies": {
    "@ch-fixedwidth/wasm-ts": "file:../wasm-ts"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "latest",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
